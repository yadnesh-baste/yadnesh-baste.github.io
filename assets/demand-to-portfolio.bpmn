<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="745" y="240"/><di:waypoint x="745" y="155"/><bpmndi:BPMNLabel><dc:Bounds x="751" y="218" width="24" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="685" y="115"/><di:waypoint x="580" y="115"/><di:waypoint x="580" y="225"/></bpmndi:BPMNEdge>
